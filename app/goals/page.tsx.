"use client";

import { useEffect, useMemo, useState } from "react";
import { createClient } from "@/lib/supabase/client";
import {
  Target,
  Plus,
  Trash2,
  X,
  Clock3,
  CheckCircle2,
  CalendarDays,
  BookOpen,
} from "lucide-react";

type Goal = {
  id: string;
  title: string;
  description: string | null;
  goal_type: string | null;
  target_value: number | null;
  current_value: number | null;
  unit: string | null;
  start_date: string | null;
  end_date: string | null;
  status: string | null;
};

const goalTypes = [
  { value: "study_hours", label: "ساعت مطالعه" },
  { value: "subject_hours", label: "ساعت مطالعه یک درس" },
  { value: "tests", label: "تعداد آزمون" },
  { value: "questions", label: "تعداد سؤال" },
  { value: "score", label: "نمره" },
  { value: "percentage", label: "درصد" },
  { value: "topics", label: "تعداد مباحث" },
  { value: "books", label: "کتاب" },
  { value: "custom", label: "هدف شخصی" },
];

export default function GoalsPage() {
  const supabase = createClient();

  const [goals, setGoals] = useState<Goal[]>([]);
  const [loading, setLoading] = useState(true);

  const [showAdd, setShowAdd] = useState(false);
  const [adding, setAdding] = useState(false);

  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [goalType, setGoalType] =
    useState("study_hours");
  const [targetValue, setTargetValue] = useState("");
  const [unit, setUnit] = useState("");
  const [startDate, setStartDate] = useState("");
  const [endDate, setEndDate] = useState("");

  async function loadGoals() {
    setLoading(true);

    const { data, error } = await supabase
      .from("goals")
      .select(
        "id,title,description,goal_type,target_value,current_value,unit,start_date,end_date,status"
      )
      .order("end_date", {
        ascending: true,
        nullsFirst: false,
      });

    if (!error && data) {
      setGoals(data);
    }

    setLoading(false);
  }

  useEffect(() => {
    loadGoals();
  }, []);

  function resetForm() {
    setTitle("");
    setDescription("");
    setGoalType("study_hours");
    setTargetValue("");
    setUnit("");
    setStartDate("");
    setEndDate("");
  }

  async function addGoal() {
    if (!title.trim() || adding) return;

    setAdding(true);

    const { error } = await supabase
      .from("goals")
      .insert({
        title: title.trim(),
        description: description.trim() || null,
        goal_type: goalType,
        target_value: targetValue
          ? Number(targetValue)
          : null,
        current_value: 0,
        unit: unit.trim() || null,
        start_date: startDate || null,
        end_date: endDate || null,
        status: "active",
      });

    if (!error) {
      resetForm();
      setShowAdd(false);
      await loadGoals();
    } else {
      console.error(error);
      alert("ثبت هدف با خطا مواجه شد.");
    }

    setAdding(false);
  }

  async function deleteGoal(id: string) {
    const goal = goals.find((item) => item.id === id);

    if (!goal) return;

    const confirmed = window.confirm(
      `هدف «${goal.title}» حذف شود؟`
    );

    if (!confirmed) return;

    await supabase
      .from("goals")
      .delete()
      .eq("id", id);

    await loadGoals();
  }

  async function updateCurrentValue(
    goal: Goal,
    value: number
  ) {
    const nextValue = Math.max(0, value);

    const completed =
      goal.target_value !== null &&
      nextValue >= Number(goal.target_value);

    const { error } = await supabase
      .from("goals")
      .update({
        current_value: nextValue,
        status: completed ? "completed" : "active",
      })
      .eq("id", goal.id);

    if (!error) {
      await loadGoals();
    }
  }

  function getGoalTypeLabel(type: string | null) {
    return (
      goalTypes.find(
        (item) => item.value === type
      )?.label || "هدف شخصی"
    );
  }

  function getProgress(goal: Goal) {
    if (
      goal.target_value === null ||
      Number(goal.target_value) <= 0
    ) {
      return 0;
    }

    return Math.min(
      100,
      (Number(goal.current_value || 0) /
        Number(goal.target_value)) *
        100
    );
  }

  function getRemainingDays(
    endDate: string | null
  ) {
    if (!endDate) return null;

    const today = new Date();
    const end = new Date(endDate);

    today.setHours(0, 0, 0, 0);
    end.setHours(0, 0, 0, 0);

    return Math.ceil(
      (end.getTime() - today.getTime()) /
        (1000 * 60 * 60 * 24)
    );
  }

  function formatDate(date: string | null) {
    if (!date) return "بدون تاریخ";

    return new Date(date).toLocaleDateString(
      "fa-IR"
    );
  }

  const completedGoals = useMemo(
    () =>
      goals.filter(
        (goal) => goal.status === "completed"
      ).length,
    [goals]
  );

  const activeGoals = useMemo(
    () =>
      goals.filter(
        (goal) => goal.status !== "completed"
      ).length,
    [goals]
  );

  const averageProgress = useMemo(() => {
    if (!goals.length) return 0;

    return (
      goals.reduce(
        (sum, goal) => sum + getProgress(goal),
        0
      ) / goals.length
    );
  }, [goals]);

  const overdueGoals = useMemo(
    () =>
      goals.filter((goal) => {
        const days = getRemainingDays(
          goal.end_date
        );

        return (
          goal.status !== "completed" &&
          days !== null &&
          days < 0
        );
      }).length,
    [goals]
  );

  return (
    <main className="page-container">
      <div className="page-header">
        <div>
          <div className="page-kicker">
            هدف‌گذاری
          </div>

          <h1>اهداف</h1>

          <p className="page-subtitle">
            اهداف کوتاه‌مدت و بلندمدتت را تعریف و میزان
            پیشرفتت را پیگیری کن.
          </p>
        </div>

        <button
          className="primary-button"
          onClick={() => setShowAdd(true)}
        >
          <Plus size={18} />
          افزودن هدف
        </button>
      </div>

      <section className="stats-grid">
        <div className="stat-card">
          <div className="stat-icon">
            <Target size={21} />
          </div>

          <div>
            <span>کل اهداف</span>
            <strong>{goals.length}</strong>
          </div>
        </div>

        <div className="stat-card">
          <div className="stat-icon">
            <Clock3 size={21} />
          </div>

          <div>
            <span>اهداف فعال</span>
            <strong>{activeGoals}</strong>
          </div>
        </div>

        <div className="stat-card">
          <div className="stat-icon">
            <CheckCircle2 size={21} />
          </div>

          <div>
            <span>تکمیل‌شده</span>
            <strong>{completedGoals}</strong>
          </div>
        </div>

        <div className="stat-card">
          <div className="stat-icon">
            <CalendarDays size={21} />
          </div>

          <div>
            <span>میانگین پیشرفت</span>
            <strong>
              {averageProgress.toFixed(0)}٪
            </strong>
          </div>
        </div>
      </section>

      {overdueGoals > 0 && (
        <div className="warning-card">
          <strong>
            {overdueGoals} هدف از موعد خود عبور کرده
            است.
          </strong>

          <span>
            وضعیت این اهداف را بررسی و در صورت نیاز
            تاریخ آن‌ها را اصلاح کن.
          </span>
        </div>
      )}

      {loading ? (
        <div className="empty-card">
          <p>در حال دریافت اهداف...</p>
        </div>
      ) : goals.length === 0 ? (
        <div className="empty-card">
          <Target size={42} />

          <h2>هنوز هدفی ثبت نشده</h2>

          <p>
            اولین هدف خودت را مشخص کن تا مسیر پیشرفتت
            قابل اندازه‌گیری شود.
          </p>

          <button
            className="primary-button"
            onClick={() => setShowAdd(true)}
          >
            <Plus size={18} />
            افزودن اولین هدف
          </button>
        </div>
      ) : (
        <section className="goal-list">
          {goals.map((goal) => {
            const progress = getProgress(goal);
            const daysRemaining =
              getRemainingDays(goal.end_date);

            const completed =
              goal.status === "completed";

            return (
              <article
                className={`goal-card ${
                  completed
                    ? "goal-completed"
                    : ""
                }`}
                key={goal.id}
              >
                <div className="goal-card-header">
                  <div className="goal-icon">
                    <Target size={21} />
                  </div>

                  <div className="goal-title">
                    <h2>{goal.title}</h2>

                    <span>
                      {getGoalTypeLabel(
                        goal.goal_type
                      )}
                    </span>
                  </div>

                  <button
                    className="icon-button danger"
                    title="حذف هدف"
                    onClick={() =>
                      deleteGoal(goal.id)
                    }
                  >
                    <Trash2 size={17} />
                  </button>
                </div>

                {goal.description && (
                  <p className="goal-description">
                    {goal.description}
                  </p>
                )}

                <div className="goal-progress-info">
                  <span>پیشرفت</span>

                  <strong>
                    {goal.current_value ?? 0}
                    {goal.unit
                      ? ` ${goal.unit}`
                      : ""}
                    {" / "}
                    {goal.target_value ?? "—"}
                    {goal.unit
                      ? ` ${goal.unit}`
                      : ""}
                  </strong>
                </div>

                <div className="progress-bar">
                  <div
                    className="progress-fill"
                    style={{
                      width: `${progress}%`,
                    }}
                  />
                </div>

                <div className="goal-footer">
                  <div className="goal-dates">
                    <span>
                      شروع:{" "}
                      {formatDate(
                        goal.start_date
                      )}
                    </span>

                    <span>
                      پایان:{" "}
                      {formatDate(
                        goal.end_date
                      )}
                    </span>
                  </div>

                  {completed ? (
                    <span className="completed-label">
                      تکمیل‌شده
                    </span>
                  ) : daysRemaining !== null ? (
                    <span
                      className={
                        daysRemaining < 0
                          ? "overdue-label"
                          : ""
                      }
                    >
                      {daysRemaining < 0
                        ? "گذشته"
                        : daysRemaining === 0
                        ? "امروز"
                        : `${daysRemaining} روز مانده`}
                    </span>
                  ) : null}
                </div>

                {!completed && (
                  <div className="goal-update">
                    <label className="form-label">
                      مقدار فعلی
                      <input
                        className="form-input"
                        type="number"
                        min="0"
                        value={
                          goal.current_value ?? 0
                        }
                        onChange={(event) =>
                          updateCurrentValue(
                            goal,
                            Number(
                              event.target.value
                            )
                          )
                        }
                      />
                    </label>
                  </div>
                )}
              </article>
            );
          })}
        </section>
      )}

      {showAdd && (
        <div
          className="modal-backdrop"
          onClick={() => setShowAdd(false)}
        >
          <div
            className="modal-card"
            onClick={(event) =>
              event.stopPropagation()
            }
          >
            <div className="modal-header">
              <div>
                <h2>افزودن هدف</h2>

                <p>
                  هدف موردنظر خودت را تعریف کن.
                </p>
              </div>

              <button
                className="icon-button"
                onClick={() => setShowAdd(false)}
              >
                <X size={19} />
              </button>
            </div>

            <div className="form-grid">
              <label className="form-label full-width">
                عنوان هدف
                <input
                  className="form-input"
                  value={title}
                  onChange={(event) =>
                    setTitle(event.target.value)
                  }
                  placeholder="مثلاً ۳۰ ساعت مطالعه در این هفته"
                  autoFocus
                />
              </label>

              <label className="form-label">
                نوع هدف
                <select
                  className="form-input"
                  value={goalType}
                  onChange={(event) =>
                    setGoalType(
                      event.target.value
                    )
                  }
                >
                  {goalTypes.map((item) => (
                    <option
                      key={item.value}
                      value={item.value}
                    >
                      {item.label}
                    </option>
                  ))}
                </select>
              </label>

              <label className="form-label">
                مقدار هدف
                <input
                  className="form-input"
                  type="number"
                  min="0"
                  value={targetValue}
                  onChange={(event) =>
                    setTargetValue(
                      event.target.value
                    )
                  }
                  placeholder="مثلاً 30"
                />
              </label>

              <label className="form-label">
                واحد
                <input
                  className="form-input"
                  value={unit}
                  onChange={(event) =>
                    setUnit(event.target.value)
                  }
                  placeholder="ساعت، درصد، سؤال..."
                />
              </label>

              <label className="form-label">
                تاریخ شروع
                <input
                  className="form-input"
                  type="date"
                  value={startDate}
                  onChange={(event) =>
                    setStartDate(
                      event.target.value
                    )
                  }
                />
              </label>

              <label className="form-label">
                تاریخ پایان
                <input
                  className="form-input"
                  type="date"
                  value={endDate}
                  onChange={(event) =>
                    setEndDate(
                      event.target.value
                    )
                  }
                />
              </label>

              <label className="form-label full-width">
                توضیحات
                <textarea
                  className="form-input form-textarea"
                  rows={3}
                  value={description}
                  onChange={(event) =>
                    setDescription(
                      event.target.value
                    )
                  }
                  placeholder="جزئیات هدف..."
                />
              </label>
            </div>

            <div className="modal-actions">
              <button
                className="secondary-button"
                onClick={() => setShowAdd(false)}
              >
                انصراف
              </button>

              <button
                className="primary-button"
                disabled={
                  adding || !title.trim()
                }
                onClick={addGoal}
              >
                {adding
                  ? "در حال ثبت..."
                  : "ثبت هدف"}
              </button>
            </div>
          </div>
        </div>
      )}
    </main>
  );
}
